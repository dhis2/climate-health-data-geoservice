# Copy to .env at the repo root. Shared by every instance: credentials only.
#
# GEOSERVICE_CONFIG is deliberately NOT set here — it selects the instance, so set it per run:
#   $env:GEOSERVICE_CONFIG = "instances/opendengue/lao/geoservice.yaml"      (PowerShell)
#   GEOSERVICE_CONFIG=instances/opendengue/lao/geoservice.yaml uv run ...     (bash)

# Earth Data Hub (DestinE), for the monthly ERA5-Land datasets
# (era5land_temperature_monthly, era5land_precipitation_monthly).
# EDH_API_KEY=<KEY>

# Copernicus Climate Data Store, for the CDS-backed ERA5-Land datasets
# (era5land_relative_humidity_daily).
# CDS_API_KEY=<KEY>

# WorldPop and Overture Maps are public and need no credentials.
