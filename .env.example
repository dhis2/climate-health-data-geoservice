# Copy to .env at the repo root. Shared by every instance: credentials only.
#
# GEOSERVICE_CONFIG is deliberately NOT set here — it selects the instance, so set it per run:
#   $env:GEOSERVICE_CONFIG = "instances/lao/geoservice.yaml"      (PowerShell)
#   GEOSERVICE_CONFIG=instances/lao/geoservice.yaml uv run ...     (bash)

# Copernicus Climate Data Store, for the ERA5-Land datasets
# (or put the same in ~/.ecmwfdatastoresrc).
# ECMWF_DATASTORES_URL=https://cds.climate.copernicus.eu/api
# ECMWF_DATASTORES_KEY=<KEY>

# WorldPop is public and needs no credentials.
